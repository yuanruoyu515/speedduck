{
  "manifest_version": 3,
  "name": "speedduck",
  "version": "1.0.1",
  "description": "精确控制网页视频和音频倍速，支持强制锁速、标签页记忆和网站记忆。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "speedduck · 播放速度",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "page.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "commands": {
    "speed-up": {
      "description": "提高 0.25 倍速"
    },
    "speed-down": {
      "description": "降低 0.25 倍速"
    },
    "speed-reset": {
      "description": "恢复 1 倍速"
    }
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'sha256-qh5KwUZXSKWpgglpTTn2zzXpBF1KLOzSPI00GlRKOdw='; object-src 'none'"
  }
}
